APP_NAME="Église Saint Joseph"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://saint-joseph.saint-arnoux.fr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
CACHE_STORE=file
# Pas de worker sur l'hébergement mutualisé : tout est synchrone.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Brevo SMTP (transactionnel) — https://app.brevo.com/settings/keys/smtp
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="information.saint-joseph@saint-arnoux.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo API (newsletter)
BREVO_API_KEY=
BREVO_LIST_ID=2
BREVO_CONSULTATION_LIST_ID=6
BREVO_CROIX_LIST_ID=7
BREVO_HUILE_LIST_ID=8

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=information.saint-joseph@saint-arnoux.fr

# Cloudflare Turnstile (anti-spam) — laisser vide pour désactiver
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Compteur de la campagne de dons RGIVE (vide = désactivé)
RGIVE_WIDGET_URL=https://don-nice.catholique.fr/api/campaign-widgets-data/7cfb9e80-9755-4e60-a6c0-0f2c82232618/

# Matomo
MATOMO_URL=https://matomo.saint-arnoux.fr/
MATOMO_SITE_ID=3
# Clé d'API Matomo (Matomo > Paramètres personnels > Sécurité > Jetons d'authentification), droit « vue » sur le site.
# Sert au graphique des visites du tableau de bord de l'admin. Facultatif.
MATOMO_TOKEN=

# Premier administrateur créé par les migrations s'il n'existe aucun utilisateur
ADMIN_EMAIL=

# --- Développement uniquement (Docker + Traefik, *.dev.saint-arnoux.fr) ---
# Certificat Let's Encrypt *.dev.saint-arnoux.fr par défi DNS via l'API cPanel d'O2Switch.
# TRAEFIK_ACME_EMAIL=
# CPANEL_USERNAME=
# CPANEL_TOKEN=
# CPANEL_BASE_URL=https://<serveur>.o2switch.net:2083
